<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ── Base application theme — dark Material3 ────────────────────── -->
    <style name="Theme.FindMyPhoneByClapLauncher"
        parent="Theme.Material3.Dark.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/color_primary</item>
        <item name="colorPrimaryVariant">@color/color_primary_variant</item>
        <item name="colorOnPrimary">@color/color_on_primary</item>

        <!-- Background -->
        <item name="android:colorBackground">@color/color_background</item>
        <item name="colorSurface">@color/color_card</item>
        <item name="colorOnSurface">@color/color_text_primary</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/color_background</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>

        <!-- Window -->
        <item name="android:windowBackground">@color/color_background</item>
        <item name="android:windowAnimationStyle">@style/Animation.Activity.Slide</item>
    </style>

    <!-- ── Launcher / Light theme for Splash & Onboarding ─────────────── -->
    <style name="Theme.FindMyPhoneByClapLauncher.Light"
        parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/color_primary</item>
        <item name="android:colorBackground">@color/color_onboarding_background</item>
        <item name="android:windowBackground">@color/color_onboarding_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>

    <!-- ── Alert theme — full red background ────────────────────────── -->
    <style name="Theme.FindMyPhoneByClapLauncher.Alert"
        parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/color_alert_background</item>
        <item name="android:colorBackground">@color/color_alert_background</item>
        <item name="android:statusBarColor">@color/color_alert_background</item>
        <item name="android:navigationBarColor">@color/color_alert_background</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
    </style>

    <!-- ── Slide animation for activity transitions ───────────────────── -->
    <style name="Animation.Activity.Slide"
        parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/slide_in_right</item>
        <item name="android:activityOpenExitAnimation">@anim/slide_out_left</item>
        <item name="android:activityCloseEnterAnimation">@anim/slide_in_left</item>
        <item name="android:activityCloseExitAnimation">@anim/slide_out_right</item>
    </style>

    <!-- ════════════════════════════════════════════════════════════════ -->
    <!-- App-level TextAppearance definitions (dark-theme screens)        -->
    <!-- ════════════════════════════════════════════════════════════════ -->

    <style name="TextAppearance.App.HeadlineLarge"
        parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textSize">@dimen/text_size_xxl</item>
        <item name="android:textColor">@color/color_text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.App.HeadlineMedium"
        parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">@dimen/text_size_xl</item>
        <item name="android:textColor">@color/color_text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.App.TitleMedium"
        parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">@dimen/text_size_lg</item>
        <item name="android:textColor">@color/color_text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.App.TitleSmall"
        parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textSize">@dimen/text_size_md</item>
        <item name="android:textColor">@color/color_text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.App.BodyMedium"
        parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">@dimen/text_size_md</item>
        <item name="android:textColor">@color/color_text_primary</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="TextAppearance.App.BodySmall"
        parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">@dimen/text_size_sm</item>
        <item name="android:textColor">@color/color_text_secondary</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="TextAppearance.App.LabelMedium"
        parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">@dimen/text_size_sm</item>
        <item name="android:textColor">@color/color_text_secondary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.App.LabelSmall"
        parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">@dimen/text_size_xs</item>
        <item name="android:textColor">@color/color_text_secondary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.App.Button"
        parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">@dimen/button_text_size</item>
        <item name="android:textColor">@color/color_on_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- ════════════════════════════════════════════════════════════════ -->
    <!-- Onboarding TextAppearances (light-bg screens)                   -->
    <!-- ════════════════════════════════════════════════════════════════ -->

    <style name="TextAppearance.App.Onboarding.HeadlineLarge"
        parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textSize">@dimen/_24ssp</item>
        <item name="android:textColor">@color/color_onboarding_text_primary</item>
        <item name="android:fontFamily">@font/inter_extrabold</item>
        <item name="fontFamily">@font/inter_extrabold</item>
    </style>

    <style name="TextAppearance.App.Onboarding.TitleMedium"
        parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">@dimen/text_size_xl</item>
        <item name="android:textColor">@color/color_onboarding_text_primary</item>
        <item name="android:fontFamily">@font/inter_bold</item>
        <item name="fontFamily">@font/inter_bold</item>
    </style>

    <style name="TextAppearance.App.Onboarding.BodyMedium"
        parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">@dimen/_13ssp</item>
        <item name="android:textColor">@color/color_onboarding_text_secondary</item>
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="fontFamily">@font/inter_medium</item>
    </style>

    <style name="TextAppearance.App.Onboarding.BodyBold"
        parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">@dimen/_13sdp</item>
        <item name="android:textColor">@color/color_onboarding_text_body</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.App.Onboarding.LabelSmall"
        parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">@dimen/text_size_xs</item>
        <item name="android:textColor">@color/color_onboarding_text_secondary</item>
    </style>

    <style name="TextAppearance.App.Onboarding.StatusHeader"
        parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">@dimen/text_size_xl</item>
        <item name="android:textColor">@color/color_primary</item>
        <item name="android:fontFamily">sans-serif-bold</item>
    </style>

</resources>