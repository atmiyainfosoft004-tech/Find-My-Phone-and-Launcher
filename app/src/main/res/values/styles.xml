<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ════════════════════════════════════════════════════════════════ -->
    <!-- Button Styles                                                    -->
    <!-- ════════════════════════════════════════════════════════════════ -->

    <!-- Primary filled blue pill button (Continue / Test it now) -->
    <style name="Widget.App.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:layout_height">@dimen/button_height</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">@dimen/button_text_size</item>
        <item name="android:textColor">@color/color_on_primary</item>
        <item name="backgroundTint">@color/color_primary</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="elevation">0dp</item>
    </style>

    <!-- Outlined button (general) -->
    <style name="Widget.App.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">@dimen/text_size_sm</item>
        <item name="strokeColor">@color/color_primary</item>
        <item name="cornerRadius">20dp</item>
    </style>

    <!-- Outlined small duration selector button -->
    <style name="Widget.App.Button.Duration" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_size_xs</item>
        <item name="cornerRadius">@dimen/_12sdp</item>
    </style>

    <!-- Outlined warning button (battery settings) -->
    <style name="Widget.App.Button.OutlinedWarning" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_size_sm</item>
        <item name="android:textColor">@color/color_warning</item>
        <item name="strokeColor">@color/color_warning</item>
        <item name="cornerRadius">20dp</item>
    </style>

    <!-- ════════════════════════════════════════════════════════════════ -->
    <!-- Card Styles                                                      -->
    <!-- ════════════════════════════════════════════════════════════════ -->

    <!-- Standard dark card -->
    <style name="Widget.App.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/color_card</item>
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/color_card_stroke</item>
    </style>

    <!-- Onboarding white card -->
    <style name="Widget.App.Card.Onboarding" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/color_onboarding_surface</item>
        <item name="cardCornerRadius">@dimen/_28sdp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="strokeColor">@color/color_onboarding_stroke</item>
    </style>

    <!-- Onboarding volume card (smaller corner) -->
    <style name="Widget.App.Card.Volume" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/color_onboarding_surface</item>
        <item name="cardCornerRadius">@dimen/_16sdp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/color_onboarding_stroke</item>
    </style>

    <style name="TextAppearance.CallLauncher.AppLabel" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">11sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:gravity">center</item>
    </style>

</resources>
