<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="@dimen/_15sdp"
    android:paddingVertical="@dimen/_10sdp"
    android:background="@color/color_onboarding_background">

    <!-- Top Mascot Speech Bubble Section -->
    <LinearLayout
        android:id="@+id/layoutMascotBubble"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="@dimen/_8sdp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Mascot Circle Avatar -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardMascot"
            android:layout_width="@dimen/_50sdp"
            android:layout_height="@dimen/_50sdp"
            android:layout_marginEnd="@dimen/_10sdp"
            app:cardBackgroundColor="@color/color_listening_circle_bg"
            app:cardCornerRadius="@dimen/_23sdp"
            app:cardElevation="0dp"
            app:strokeWidth="1.5dp"
            android:layout_marginBottom="@dimen/_10sdp"
            app:strokeColor="@color/color_listening_circle_stroke">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/imgMascot"
                android:layout_width="@dimen/_50sdp"
                android:layout_height="@dimen/_50sdp"
                android:layout_gravity="center"
                android:scaleType="centerInside"
                android:adjustViewBounds="true"
                android:src="@drawable/ic_mascot_owl"
                android:contentDescription="@string/content_desc_mascot" />

        </com.google.android.material.card.MaterialCardView>

        <!-- White Speech Bubble Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSpeechBubble"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="@dimen/_10sdp"
            app:strokeColor="@color/color_onboarding_stroke">

            <TextView
                android:id="@+id/txtMascotBubble"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/_10sdp"
                android:gravity="bottom"
                android:text="@string/mascot_permission_text"
                android:textAppearance="@style/TextAppearance.App.Onboarding.BodyBold"
                android:textColor="@color/color_onboarding_text_primary"
                android:fontFamily="@font/inter_medium"
                app:fontFamily="@font/inter_medium"
                android:lineSpacingExtra="@dimen/_2sdp" />

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!-- Center Outer Phone Device Frame Container -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardPermissionContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/_14sdp"
        android:layout_marginBottom="@dimen/_14sdp"
        app:cardBackgroundColor="#F1F5F9"
        app:cardCornerRadius="@dimen/_28sdp"
        app:cardElevation="0dp"
        app:strokeWidth="1.5dp"
        app:strokeColor="@color/color_onboarding_stroke"
        app:layout_constraintTop_toBottomOf="@id/layoutMascotBubble"
        app:layout_constraintBottom_toTopOf="@id/btnContinue"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Black Camera Notch at top center -->
            <View
                android:id="@+id/viewNotch"
                android:layout_width="@dimen/_54sdp"
                android:layout_height="@dimen/_10sdp"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="@dimen/_10sdp"
                android:background="@drawable/bg_notch_pill" />

            <!-- Inner White Permission Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@id/viewNotch"
                android:layout_marginHorizontal="@dimen/_14sdp"
                android:layout_marginTop="@dimen/_12sdp"
                android:layout_marginBottom="@dimen/_14sdp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/_20sdp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/color_onboarding_stroke">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="@dimen/_18sdp">

                    <!-- Center Voice Microphone Icon (Double-ringed) -->
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/imgVoiceIcon"
                        android:layout_width="@dimen/_90sdp"
                        android:layout_height="@dimen/_90sdp"
                        android:layout_gravity="center"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_ob_voice_icon"
                        android:contentDescription="@string/content_desc_microphone" />

                    <!-- Title -->
                    <TextView
                        android:id="@+id/txtAudioAccessTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/audio_access_needed"
                        android:textAppearance="@style/TextAppearance.App.Onboarding.TitleMedium"
                        android:textColor="@color/color_onboarding_text_primary"
                        android:fontFamily="@font/inter_bold"
                        app:fontFamily="@font/inter_bold"
                        android:textAlignment="center"
                        android:layout_marginTop="@dimen/_16sdp" />

                    <!-- Description -->
                    <TextView
                        android:id="@+id/txtAudioAccessDesc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/audio_access_desc"
                        android:textAppearance="@style/TextAppearance.App.Onboarding.BodyMedium"
                        android:textColor="@color/color_onboarding_text_secondary"
                        android:fontFamily="@font/inter_medium"
                        app:fontFamily="@font/inter_medium"
                        android:textAlignment="center"
                        android:lineSpacingExtra="@dimen/_3sdp"
                        android:layout_marginTop="@dimen/_8sdp" />

                    <!-- Privacy Badge Pill -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="@dimen/_14sdp"
                        android:paddingVertical="@dimen/_8sdp"
                        android:background="@drawable/bg_privacy_pill"
                        android:layout_marginTop="@dimen/_20sdp">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/imgLock"
                            android:layout_width="@dimen/_14sdp"
                            android:layout_height="@dimen/_14sdp"
                            android:src="@drawable/ic_lock"
                            android:contentDescription="@string/privacy_matters_text"
                            app:tint="@color/color_primary" />

                        <TextView
                            android:id="@+id/txtPrivacyMatters"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/privacy_matters_text"
                            android:textAppearance="@style/TextAppearance.App.Onboarding.BodyBold"
                            android:textColor="@color/color_primary"
                            android:fontFamily="@font/inter_semibold"
                            app:fontFamily="@font/inter_semibold"
                            android:layout_marginStart="@dimen/_6sdp" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </RelativeLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Bottom Continue Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnContinue"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:text="@string/btn_continue"
        android:layout_marginBottom="@dimen/_10sdp"
        android:fontFamily="@font/inter_semibold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
