<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background">

    <!-- Top Header Bar -->
    <LinearLayout
        android:id="@+id/layoutHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/_20sdp"
        android:paddingTop="@dimen/_40sdp"
        android:paddingBottom="@dimen/_12sdp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Settings Button -->
        <ImageView
            android:id="@+id/btnSettings"
            android:layout_width="@dimen/_36sdp"
            android:layout_height="@dimen/_36sdp"
            android:padding="@dimen/_4sdp"
            android:src="@drawable/ic_menu"
            android:contentDescription="@string/settings"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="@dimen/_14sdp"
            app:tint="@color/color_text_primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/find_phone_title"
                android:textAppearance="@style/TextAppearance.App.HeadlineMedium" />

            <TextView
                android:id="@+id/txtSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/find_phone_subtitle"
                android:textAppearance="@style/TextAppearance.App.BodySmall"
                android:layout_marginTop="@dimen/_2sdp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Main Content Scroll Container -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/_24sdp"
        app:layout_constraintTop_toBottomOf="@id/layoutHeader"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/_16sdp"
            android:paddingTop="@dimen/_8sdp">

            <!-- 1. Main Status Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMasterStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/color_card"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="@dimen/card_elevation"
                app:strokeWidth="1dp"
                app:strokeColor="@color/color_card_stroke">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/_20sdp"
                    android:paddingVertical="@dimen/_20sdp">

                    <TextView
                        android:id="@+id/txtMasterTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/find_phone_title"
                        android:textAppearance="@style/TextAppearance.App.TitleMedium"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/swMaster" />

                    <TextView
                        android:id="@+id/txtMasterStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/service_status_off"
                        android:textAppearance="@style/TextAppearance.App.BodySmall"
                        android:layout_marginTop="@dimen/_4sdp"
                        app:layout_constraintTop_toBottomOf="@id/txtMasterTitle"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/swMaster" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/swMaster"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:scaleX="1.2"
                        android:scaleY="1.2"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- 2. Detection Cards (3 Clap + Whistle Side-by-Side) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/_16sdp">

                <!-- Card: 3 Clap Detection -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardClap"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_180sdp"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/_8sdp"
                    app:cardBackgroundColor="@color/color_card"
                    app:cardCornerRadius="@dimen/card_corner_radius"
                    app:cardElevation="@dimen/card_elevation"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/color_card_stroke">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="@dimen/_14sdp">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/imgClap"
                            android:layout_width="@dimen/_48sdp"
                            android:layout_height="@dimen/_48sdp"
                            android:src="@drawable/ic_clap_hands"
                            android:contentDescription="@string/content_desc_clap_icon"
                            app:tint="@color/color_text_primary" />

                        <TextView
                            android:id="@+id/txtClapTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/find_phone_3_claps"
                            android:textAppearance="@style/TextAppearance.App.TitleSmall"
                            android:textAlignment="center"
                            android:layout_marginTop="@dimen/_6sdp" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/swClap"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_10sdp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Card: Whistle Detection -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardWhistle"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_180sdp"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/_8sdp"
                    app:cardBackgroundColor="@color/color_card"
                    app:cardCornerRadius="@dimen/card_corner_radius"
                    app:cardElevation="@dimen/card_elevation"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/color_card_stroke">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="@dimen/_14sdp">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/imgWhistle"
                            android:layout_width="@dimen/_48sdp"
                            android:layout_height="@dimen/_48sdp"
                            android:src="@drawable/ic_whistle"
                            android:contentDescription="@string/content_desc_whistle_icon"
                            app:tint="@color/color_text_primary" />

                        <TextView
                            android:id="@+id/txtWhistleTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/find_phone_whistle"
                            android:textAppearance="@style/TextAppearance.App.TitleSmall"
                            android:textAlignment="center"
                            android:layout_marginTop="@dimen/_6sdp" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/swWhistle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_10sdp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- 3. Alert Multi System Settings Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAlertSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_16sdp"
                app:cardBackgroundColor="@color/color_card"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="@dimen/card_elevation"
                app:strokeWidth="1dp"
                app:strokeColor="@color/color_card_stroke">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/_18sdp">

                    <TextView
                        android:id="@+id/txtMultiAlertTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_multi_alert_settings"
                        android:textAppearance="@style/TextAppearance.App.TitleSmall" />

                    <!-- Sound Alert Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="@dimen/_12sdp">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/imgSoundAlert"
                            android:layout_width="@dimen/_20sdp"
                            android:layout_height="@dimen/_20sdp"
                            android:src="@drawable/ic_volume_high"
                            android:contentDescription="@string/content_desc_sound_alert"
                            app:tint="@color/color_text_primary" />

                        <TextView
                            android:id="@+id/txtSoundAlert"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/label_sound_alert"
                            android:textAppearance="@style/TextAppearance.App.BodyMedium"
                            android:layout_marginStart="@dimen/_8sdp" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/swSoundAlert"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                    </LinearLayout>

                    <!-- Flashlight Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="@dimen/_8sdp">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/imgFlashlightAlert"
                            android:layout_width="@dimen/_20sdp"
                            android:layout_height="@dimen/_20sdp"
                            android:src="@drawable/ic_flashlight"
                            android:contentDescription="@string/content_desc_flashlight_alert"
                            app:tint="@color/color_text_primary" />

                        <TextView
                            android:id="@+id/txtFlashlightAlert"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/label_flashlight_alert"
                            android:textAppearance="@style/TextAppearance.App.BodyMedium"
                            android:layout_marginStart="@dimen/_8sdp" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/swFlashlightAlert"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                    </LinearLayout>

                    <!-- Vibration Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="@dimen/_8sdp">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/imgVibrationAlert"
                            android:layout_width="@dimen/_20sdp"
                            android:layout_height="@dimen/_20sdp"
                            android:src="@drawable/ic_vibration"
                            android:contentDescription="@string/content_desc_vibration_alert"
                            app:tint="@color/color_text_primary" />

                        <TextView
                            android:id="@+id/txtVibrationAlert"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/label_vibration_alert"
                            android:textAppearance="@style/TextAppearance.App.BodyMedium"
                            android:layout_marginStart="@dimen/_8sdp" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/swVibrationAlert"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/color_divider_subtle"
                        android:layout_marginVertical="@dimen/_14sdp" />

                    <!-- Alert Sound Selection + Preview -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/txtAlertSoundTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/label_alert_sound"
                            android:textAppearance="@style/TextAppearance.App.TitleSmall" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPreviewSound"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/_36sdp"
                            android:text="@string/label_preview_sound"
                            android:textAppearance="@style/TextAppearance.App.LabelSmall"
                            android:textColor="@color/color_primary"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            app:icon="@drawable/ic_play"
                            app:iconTint="@color/color_primary"
                            app:iconGravity="textStart"
                            app:strokeColor="@color/color_primary"
                            app:cornerRadius="@dimen/_18sdp" />

                    </LinearLayout>

                    <!-- Radio Group for Alert Sound -->
                    <RadioGroup
                        android:id="@+id/rgSounds"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="@dimen/_8sdp">

                        <RadioButton
                            android:id="@+id/rbSoundWhistle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/radio_sound_whistle"
                            android:textAppearance="@style/TextAppearance.App.BodyMedium" />

                        <RadioButton
                            android:id="@+id/rbSoundMelody"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/radio_sound_melody"
                            android:textAppearance="@style/TextAppearance.App.BodyMedium" />

                        <RadioButton
                            android:id="@+id/rbSoundAnimal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/radio_sound_animal"
                            android:textAppearance="@style/TextAppearance.App.BodyMedium" />

                        <RadioButton
                            android:id="@+id/rbSoundElectronic"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/radio_sound_electronic"
                            android:textAppearance="@style/TextAppearance.App.BodyMedium" />

                    </RadioGroup>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/color_divider_subtle"
                        android:layout_marginVertical="@dimen/_14sdp" />

                    <!-- Alert Duration Selection -->
                    <TextView
                        android:id="@+id/txtAlertDurationTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_alert_duration"
                        android:textAppearance="@style/TextAppearance.App.TitleSmall" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="@dimen/_10sdp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDuration10"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/_40sdp"
                            android:layout_weight="1"
                            android:layout_marginEnd="@dimen/_4sdp"
                            android:text="10s"
                            style="@style/Widget.App.Button.Duration" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDuration30"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/_40sdp"
                            android:layout_weight="1"
                            android:layout_marginHorizontal="@dimen/_2sdp"
                            android:text="30s"
                            style="@style/Widget.App.Button.Duration" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDuration60"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/_40sdp"
                            android:layout_weight="1"
                            android:layout_marginHorizontal="@dimen/_2sdp"
                            android:text="60s"
                            style="@style/Widget.App.Button.Duration" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDuration120"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/_40sdp"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/_4sdp"
                            android:text="120s"
                            style="@style/Widget.App.Button.Duration" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- 4. Battery Optimization Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardBatteryOpt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_16sdp"
                app:cardBackgroundColor="@color/color_card_battery"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="@dimen/card_elevation"
                app:strokeWidth="1dp"
                app:strokeColor="@color/color_card_battery_stroke">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/_18sdp">

                    <TextView
                        android:id="@+id/txtKeepActiveTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_keep_active"
                        android:textAppearance="@style/TextAppearance.App.TitleSmall" />

                    <TextView
                        android:id="@+id/txtBatteryDesc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_battery_desc"
                        android:textAppearance="@style/TextAppearance.App.BodySmall"
                        android:lineSpacingExtra="@dimen/_3sdp"
                        android:layout_marginTop="@dimen/_6sdp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOpenBatteryOpt"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/_40sdp"
                        android:text="@string/label_open_battery_settings"
                        style="@style/Widget.App.Button.OutlinedWarning"
                        android:layout_marginTop="@dimen/_12sdp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
