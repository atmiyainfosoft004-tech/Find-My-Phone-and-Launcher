<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardSound"
    android:layout_width="match_parent"
    android:layout_height="@dimen/_100sdp"
    android:layout_margin="@dimen/_4sdp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="@dimen/_15sdp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/color_onboarding_stroke">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="@dimen/_6sdp">

        <!-- Selected Checkmark Badge (Top-Right Corner) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardCheckmark"
            android:layout_width="@dimen/_16sdp"
            android:layout_height="@dimen/_16sdp"
            android:layout_marginTop="@dimen/_2sdp"
            android:layout_marginEnd="@dimen/_2sdp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/color_primary"
            app:cardCornerRadius="@dimen/_8sdp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/imgCheckmark"
                android:layout_width="@dimen/_10sdp"
                android:layout_height="@dimen/_10sdp"
                android:layout_gravity="center"
                android:src="@drawable/ic_check"
                android:contentDescription="@string/content_desc_checkmark"
                app:tint="@color/white" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Center Perfect Icon Circle Container -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardIconCircle"
            android:layout_width="@dimen/_42sdp"
            android:layout_height="@dimen/_42sdp"
            android:layout_marginTop="@dimen/_4sdp"
            app:cardBackgroundColor="#F1F5F9"
            app:cardCornerRadius="@dimen/_21sdp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/txtSoundName"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintVertical_chainStyle="packed">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/imgSoundIcon"
                android:layout_width="@dimen/_22sdp"
                android:layout_height="@dimen/_22sdp"
                android:layout_gravity="center"
                android:src="@drawable/ic_sound_ringtone"
                android:contentDescription="@string/content_desc_sound_item_icon"
                app:tint="#475569" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Sound Name Text -->
        <TextView
            android:id="@+id/txtSoundName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/your_ringtone"
            android:textAppearance="@style/TextAppearance.App.Onboarding.LabelSmall"
            android:textColor="@color/color_onboarding_text_primary"
            app:fontFamily="@font/inter_semibold"
            android:textAlignment="center"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginTop="@dimen/_6sdp"
            app:layout_constraintTop_toBottomOf="@id/cardIconCircle"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
