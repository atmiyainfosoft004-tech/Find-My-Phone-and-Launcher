<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:paddingHorizontal="@dimen/_15sdp"
    android:paddingVertical="@dimen/_10sdp">

    <!-- Confetti Party Particles Background -->
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/imgConfettiBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:lottie_rawRes="@raw/congratulation"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"/>

    <!-- Lottie Animation from raw/bell_found_phone -->
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lottieBell"
        android:layout_width="@dimen/_200sdp"
        android:layout_height="@dimen/_200sdp"
        app:layout_constraintBottom_toTopOf="@+id/btnStopAlert"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.45"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        app:lottie_rawRes="@raw/bell_ring_only" />

    <!-- Main Headline: "Yeah!" -->
    <TextView
        android:id="@+id/txtAlertTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/yeahTitle"
        android:textColor="@color/color_text_on_light"
        android:textSize="@dimen/_22ssp"
        android:fontFamily="@font/inter_bold"
        android:textAlignment="center"
        android:layout_marginHorizontal="@dimen/_24sdp"
        app:layout_constraintTop_toBottomOf="@id/lottieBell"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Subtitle: "You’ve Found Your Phone" -->
    <TextView
        android:id="@+id/txtAlertSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/youveFoundYourPhone"
        android:textColor="@color/color_text_on_light"
        android:textSize="@dimen/_16ssp"
        android:fontFamily="@font/inter_bold"
        android:textAlignment="center"
        android:layout_marginTop="@dimen/_6sdp"
        android:layout_marginHorizontal="@dimen/_24sdp"
        app:layout_constraintTop_toBottomOf="@id/txtAlertTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Prominent Blue Pill "Dismiss" Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStopAlert"
        android:layout_width="0dp"
        android:layout_height="@dimen/button_height"
        android:text="@string/btnDismiss"
        android:textColor="@color/white"
        android:textSize="@dimen/_14ssp"
        android:fontFamily="@font/inter_bold"
        android:textAllCaps="false"
        style="@style/Widget.Material3.Button"
        app:backgroundTint="@color/color_primary"
        app:cornerRadius="@dimen/_25sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginHorizontal="@dimen/_24sdp"
        android:layout_marginBottom="@dimen/_10sdp" />

</androidx.constraintlayout.widget.ConstraintLayout>
