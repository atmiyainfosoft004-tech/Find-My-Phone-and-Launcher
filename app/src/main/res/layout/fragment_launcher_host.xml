<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLauncher"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:clipChildren="false"
    android:fitsSystemWindows="false"
    android:hardwareAccelerated="true">

    <!-- Holds a copy of the system wallpaper for drawer blur -->
    <ImageView
        android:id="@+id/ivWallpaper"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:background="@android:color/transparent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Home layer: ViewPager2 for horizontal page swiping -->
    <com.example.findmyphonebyclaplauncher.ui.common.SwipeUpInterceptLayout
        android:id="@+id/swipeUpIntercept"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never" />
    </com.example.findmyphonebyclaplauncher.ui.common.SwipeUpInterceptLayout>

    <!-- Edge Tab on left for direct access -->
    <FrameLayout
        android:id="@+id/edgeTab"
        android:layout_width="70dp"
        android:layout_height="58dp"
        android:background="@drawable/bg_edge_tab"
        android:clickable="true"
        android:elevation="10dp"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.40">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardEdgeTabIcon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="6dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <ImageView
                android:id="@+id/ivEdgeTabIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:contentDescription="@string/app_name"
                android:src="@mipmap/ic_launcher" />
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>

    <!-- Page indicator — above dock -->
    <eightbitlab.com.blurview.BlurView
        android:id="@+id/glassPageIndicatorBlur"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/page_indicator_height"
        android:layout_marginBottom="@dimen/page_indicator_margin_bottom"
        android:background="@drawable/bg_page_indicator"
        android:clickable="false"
        android:elevation="2dp"
        android:focusable="false"
        app:blurOverlayColor="@color/glass_dark"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/pageIndicatorBlur"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/page_indicator_height"
            android:layout_marginBottom="@dimen/page_indicator_margin_bottom"
            android:background="@drawable/bg_page_indicator"
            android:elevation="10dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <ImageView
                android:id="@+id/btnPagePhone"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/phone"
                android:padding="8dp"
                android:src="@drawable/ic_phone"
                app:tint="@color/text_secondary" />

            <ImageView
                android:id="@+id/btnPageHome"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/home"
                android:padding="8dp"
                android:src="@drawable/ic_home_dash"
                app:tint="@color/white" />

            <ImageView
                android:id="@+id/btnPageApps"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/apps"
                android:padding="8dp"
                android:src="@drawable/ic_apps_grid"
                app:tint="@color/text_secondary" />
        </LinearLayout>
    </eightbitlab.com.blurview.BlurView>

    <!-- Drawer overlay container -->
    <FrameLayout
        android:id="@+id/drawerContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clickable="true"
        android:elevation="24dp"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <View
            android:id="@+id/drawerScrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"
            android:background="#FF000000" />

        <com.example.findmyphonebyclaplauncher.ui.common.SwipeDownDismissLayout
            android:id="@+id/drawerDismiss"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_drawer_panel"
            android:clickable="true"
            android:focusable="true"
            android:hardwareAccelerated="true">

            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/drawerHost"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </com.example.findmyphonebyclaplauncher.ui.common.SwipeDownDismissLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
