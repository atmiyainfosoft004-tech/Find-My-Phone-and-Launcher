<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />
    <!-- Microphone for sound detection -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Foreground service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- Notifications (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Vibration -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Flashlight via Camera2 -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Battery optimization request -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Wake device screen on alert -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- System alert window for lock-screen alert -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- Package query permission for Launcher -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DELETE" />
            <data android:scheme="package" />
        </intent>
        <intent>
            <action android:name="android.intent.action.UNINSTALL_PACKAGE" />
            <data android:scheme="package" />
        </intent>
    </queries>

    <uses-feature
        android:name="android.hardware.camera.flash"
        android:required="false" />

    <uses-feature
        android:name="android.hardware.microphone"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FindMyPhoneByClapLauncher"
        tools:targetApi="31">

        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713" />
        <meta-data
            android:name="com.google.android.gms.ads.flag.OPTIMIZE_INITIALIZATION"
            android:value="false"
            tools:replace="android:value" />
        <meta-data
            android:name="com.google.android.gms.ads.flag.OPTIMIZE_AD_LOADING"
            android:value="false"
            tools:replace="android:value" />

        <!-- ===================== ACTIVITIES ===================== -->

        <!-- Splash screen (Main entry point) -->
        <activity
            android:name=".ui.splash.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.FindMyPhoneByClapLauncher.Light">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Onboarding -->
        <activity
            android:name=".ui.onboarding.OnboardingActivity"
            android:exported="false"
            android:theme="@style/Theme.FindMyPhoneByClapLauncher.Light" />

        <!-- Find Phone Main Dashboard / Default Home Launcher Activity -->
        <activity
            android:name=".ui.findphone.FindPhoneActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:theme="@style/Theme.FindMyPhoneByClapLauncher.Light"
            android:windowSoftInputMode="adjustPan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Settings -->
        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.FindMyPhoneByClapLauncher" />

        <!-- Menu Activity -->
        <activity
            android:name=".ui.menu.MenuActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:theme="@style/Theme.FindMyPhoneByClapLauncher.Light" />

        <!-- Alert Sensitivity Activity -->
        <activity
            android:name=".ui.settings.AlertSensitivityActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:theme="@style/Theme.FindMyPhoneByClapLauncher.Light" />

        <!-- Alert Sound Activity -->
        <activity
            android:name=".ui.settings.AlertSoundActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:theme="@style/Theme.FindMyPhoneByClapLauncher.Light" />

        <!-- Alert (lock-screen capable) -->
        <activity
            android:name=".ui.alert.AlertActivity"
            android:exported="false"
            android:theme="@style/Theme.FindMyPhoneByClapLauncher.Alert"
            android:showWhenLocked="true"
            android:showOnLockScreen="true"
            android:launchMode="singleInstance"
            android:turnScreenOn="true"
            android:screenOrientation="portrait" />

        <!-- ===================== SERVICE ===================== -->
        <service
            android:name=".service.SoundDetectionService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

    </application>

</manifest>