<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Microphone for sound detection -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Foreground service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- Notifications (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Vibration -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Flashlight via Camera2 -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Battery optimization request -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Wake device screen on alert -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- System alert window for lock-screen alert -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <uses-feature
        android:name="android.hardware.camera.flash"
        android:required="false" />

    <uses-feature
        android:name="android.hardware.microphone"
        android:required="true" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FindMyPhoneByClapLauncher"
        tools:targetApi="31">

        <!-- ===================== ACTIVITIES ===================== -->

        <!-- Splash screen (Main entry point) -->
        <activity
            android:name=".ui.splash.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.FindMyPhoneByClapLauncher.Light">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Onboarding -->
        <activity
            android:name=".ui.onboarding.OnboardingActivity"
            android:exported="false"
            android:theme="@style/Theme.FindMyPhoneByClapLauncher.Light" />

        <!-- Find Phone Main Dashboard Activity -->
        <activity
            android:name=".ui.findphone.FindPhoneActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:theme="@style/Theme.FindMyPhoneByClapLauncher" />

        <!-- Settings -->
        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.FindMyPhoneByClapLauncher" />

        <!-- Alert (lock-screen capable) -->
        <activity
            android:name=".ui.alert.AlertActivity"
            android:exported="false"
            android:theme="@style/Theme.FindMyPhoneByClapLauncher.Alert"
            android:showOnLockScreen="true"
            android:launchMode="singleInstance"
            android:turnScreenOn="true"
            android:screenOrientation="portrait" />

        <!-- ===================== SERVICE ===================== -->
        <service
            android:name=".service.SoundDetectionService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

    </application>

</manifest>